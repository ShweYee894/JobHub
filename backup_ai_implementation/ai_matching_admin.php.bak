<?php
require_once __DIR__ . '/../config/db.php';
require_once __DIR__ . '/../auth/auth.php';
require_role('admin');

$currentPage = 'matching';

// Stats for the dashboard
$stats = [
    'total_jobs' => 0,
    'jobs_with_embedding' => 0,
    'total_freelancers' => 0,
    'freelancers_with_vector' => 0,
    'avg_match_score' => 0,
];

$r = $conn->query('SELECT COUNT(*) AS c FROM jobs');
$stats['total_jobs'] = $r->fetch_assoc()['c'];

$r = $conn->query("SELECT COUNT(*) AS c FROM jobs WHERE embedding_vector IS NOT NULL AND embedding_vector != ''");
$stats['jobs_with_embedding'] = $r->fetch_assoc()['c'];

$r = $conn->query('SELECT COUNT(*) AS c FROM freelancers');
$stats['total_freelancers'] = $r->fetch_assoc()['c'];

$r = $conn->query("SELECT COUNT(*) AS c FROM freelancers WHERE skills_vector IS NOT NULL AND skills_vector != ''");
$stats['freelancers_with_vector'] = $r->fetch_assoc()['c'];

// Fetch jobs for dropdown
$jobs_result = $conn->query('SELECT id, title FROM jobs ORDER BY created_at DESC LIMIT 200');

// Fetch freelancers for dropdown
$freelancers_result = $conn->query('
    SELECT f.id, u.name
    FROM freelancers f
    JOIN users u ON f.user_id = u.id
    ORDER BY u.name ASC
    LIMIT 200
');

$_userId = $_SESSION['user_id'];
$sStmt = $conn->prepare('SELECT name, profile_image FROM users WHERE id = ?');
$sStmt->bind_param('i', $_userId);
$sStmt->execute();
$_navUserRow = $sStmt->get_result()->fetch_assoc();
$sStmt->close();
$adminName = $_navUserRow['name'] ?? 'Admin';

$conn->close();

$navItems = [
