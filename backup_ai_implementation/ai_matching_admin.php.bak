            </div>


<script>
function matchFreelancers() {
    const jobId = document.getElementById('jobSelect').value;
    if (!jobId) { alert('Please select a job.'); return; }

    const resultsDiv = document.getElementById('freelancerResults');
    const loadingDiv = document.getElementById('freelancerResultsLoading');
    const contentDiv = document.getElementById('freelancerResultsContent');
    const tbody = document.getElementById('freelancerTableBody');

    resultsDiv.classList.remove('hidden');
    loadingDiv.classList.remove('hidden');
    contentDiv.classList.add('hidden');

    fetch('/jobhub/api/ai_matching.php?action=match_freelancers&job_id=' + jobId)
        .then(r => r.json())
        .then(data => {
            loadingDiv.classList.add('hidden');
            contentDiv.classList.remove('hidden');
            tbody.innerHTML = '';

            if (!data.matches || data.matches.length === 0) {
                tbody.innerHTML = '<tr><td colspan="9" class="py-8 text-center text-gray-400">No matches found.</td></tr>';
                return;
            }

            data.matches.forEach((m, i) => {
                const scoreColor = m.total_score >= 60 ? 'text-emerald-600 bg-emerald-50' :
                                   m.total_score >= 40 ? 'text-blue-600 bg-blue-50' :
                                   m.total_score >= 20 ? 'text-amber-600 bg-amber-50' : 'text-gray-600 bg-gray-50';
                const availColor = m.availability === 'Available' ? 'text-emerald-600' : 'text-amber-600';
                tbody.innerHTML += `
                    <tr class="border-b border-50 hover:bg-gray-50 transition-colors">
                        <td class="py-3 px-3 font-bold text-gray-400">${i+1}</td>
                        <td class="py-3 px-3">
                            <div class="flex items-center gap-3">
                                <img src="/jobhub/assets/upload/profiles/${m.profile_image || 'profile.png'}" class="w-8 h-8 rounded-full object-cover" onerror="this.src='https://ui-avatars.com/api/?name=${encodeURIComponent(m.name)}&background=2563eb&color=fff'">
                                <div>
                                    <p class="font-medium text-gray-900">${escapeHtml(m.name)}</p>
                                    <p class="text-xs text-gray-400">${escapeHtml(m.title || '')}</p>
                                </div>
                            </div>
                        </td>
                        <td class="py-3 px-3">
                            <div class="flex flex-wrap gap-1">${(m.skill_names||[]).slice(0,3).map(s => '<span class="px-2 py-0.5 bg-blue-50 text-blue-600 rounded text-[10px] font-semibold">' + escapeHtml(s) + '</span>').join('')}</div>
                        </td>
                        <td class="py-3 px-3 text-gray-600">$${Number(m.hourly_rate).toFixed(2)}/hr</td>
                        <td class="py-3 px-3">
                            <div class="flex items-center gap-2">
                                <div class="w-16 bg-gray-100 rounded-full h-1.5"><div class="bg-blue-500 h-1.5 rounded-full" style="width:${Math.min(100, m.breakdown.skill_match / 50 * 100)}%"></div></div>
                                <span class="text-xs font-semibold text-gray-600">${m.breakdown.skill_match}/50</span>
                            </div>
                        </td>
                        <td class="py-3 px-3"><span class="text-xs font-semibold ${m.breakdown.rate_fit >= 20 ? 'text-emerald-600' : 'text-gray-400'}">${m.breakdown.rate_fit}/20</span></td>
                        <td class="py-3 px-3"><span class="text-xs font-semibold text-gray-600">${m.breakdown.experience}/15</span></td>
                        <td class="py-3 px-3"><span class="text-xs font-semibold ${availColor}">${m.breakdown.availability}/15</span></td>
                        <td class="py-3 px-3"><span class="px-3 py-1 rounded-lg text-sm font-bold ${scoreColor}">${m.total_score}%</span></td>
                    </tr>`;
            });
        })
        .catch(err => {
            loadingDiv.classList.add('hidden');
            tbody.innerHTML = '<tr><td colspan="9" class="py-8 text-center text-red-400">Error fetching matches.</td></tr>';
            contentDiv.classList.remove('hidden');
        });
}

function matchJobs() {
    const freelancerId = document.getElementById('freelancerSelect').value;
    if (!freelancerId) { alert('Please select a freelancer.'); return; }

    const resultsDiv = document.getElementById('jobResults');
    const loadingDiv = document.getElementById('jobResultsLoading');
    const contentDiv = document.getElementById('jobResultsContent');
    const tbody = document.getElementById('jobTableBody');

    resultsDiv.classList.remove('hidden');
    loadingDiv.classList.remove('hidden');
    contentDiv.classList.add('hidden');

    fetch('/jobhub/api/ai_matching.php?action=match_jobs&freelancer_id=' + freelancerId)
        .then(r => r.json())
        .then(data => {
            loadingDiv.classList.add('hidden');
            contentDiv.classList.remove('hidden');
            tbody.innerHTML = '';

            if (!data.matches || data.matches.length === 0) {
                tbody.innerHTML = '<tr><td colspan="9" class="py-8 text-center text-gray-400">No matches found.</td></tr>';
                return;
            }

            data.matches.forEach((m, i) => {
                const scoreColor = m.total_score >= 50 ? 'text-emerald-600 bg-emerald-50' :
                                   m.total_score >= 30 ? 'text-blue-600 bg-blue-50' :
                                   m.total_score >= 15 ? 'text-amber-600 bg-amber-50' : 'text-gray-600 bg-gray-50';
                tbody.innerHTML += `
                    <tr class="border-b border-50 hover:bg-gray-50 transition-colors">
                        <td class="py-3 px-3 font-bold text-gray-400">${i+1}</td>
                        <td class="py-3 px-3">
                            <a href="/jobhub/client/job_detail.php?id=${m.job_id}" class="font-medium text-gray-900 hover:text-blue-600 transition-colors">${escapeHtml(m.title)}</a>
                        </td>
                        <td class="py-3 px-3 text-gray-600">${escapeHtml(m.client_name)}</td>
                        <td class="py-3 px-3 text-gray-600">$${Number(m.budget).toFixed(2)}</td>
                        <td class="py-3 px-3">
                            <div class="flex flex-wrap gap-1">${(m.skill_names||[]).slice(0,3).map(s => '<span class="px-2 py-0.5 bg-blue-50 text-blue-600 rounded text-[10px] font-semibold">' + escapeHtml(s) + '</span>').join('')}</div>
                        </td>
                        <td class="py-3 px-3">
                            <div class="flex items-center gap-2">
                                <div class="w-16 bg-gray-100 rounded-full h-1.5"><div class="bg-blue-500 h-1.5 rounded-full" style="width:${Math.min(100, m.breakdown.skill_match / 60 * 100)}%"></div></div>
                                <span class="text-xs font-semibold text-gray-600">${m.breakdown.skill_match}/60</span>
                            </div>
                        </td>
                        <td class="py-3 px-3"><span class="text-xs font-semibold ${m.breakdown.budget_fit >= 20 ? 'text-emerald-600' : 'text-gray-400'}">${m.breakdown.budget_fit}/20</span></td>
                        <td class="py-3 px-3"><span class="text-xs font-semibold text-gray-600">${m.breakdown.recency.toFixed(1)}/10</span></td>
                        <td class="py-3 px-3"><span class="px-3 py-1 rounded-lg text-sm font-bold ${scoreColor}">${m.total_score}%</span></td>
                    </tr>`;
            });
        })
        .catch(err => {
            loadingDiv.classList.add('hidden');
            tbody.innerHTML = '<tr><td colspan="9" class="py-8 text-center text-red-400">Error fetching matches.</td></tr>';
            contentDiv.classList.remove('hidden');
        });
}

function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}
</script>
<?php require_once __DIR__ . '/../components/layout_end.php'; ?>
