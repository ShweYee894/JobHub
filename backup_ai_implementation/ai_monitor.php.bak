    <!-- ═══ LOG FILTER STYLES + JS ═══════════════════════════════════════ -->
    <style>
        .log-filter-pill.active { background: #111827; color: #fff; }
        .dark .log-filter-pill.active { background: #3B82F6; color: #fff; }
        .log-entry { transition: background .12s, opacity .2s; }
        .log-entry.hidden { display: none; }
    </style>
    <script>
    function filterLog(category) {
        // Update active pill
        document.querySelectorAll('.log-filter-pill').forEach(function(btn) {
            btn.classList.remove('active');
            btn.classList.add('text-gray-500', 'dark:text-slate-400');
        });
        var activeBtn = document.querySelector('[data-log-filter="' + category + '"]');
        if (activeBtn) {
            activeBtn.classList.add('active');
            activeBtn.classList.remove('text-gray-500', 'dark:text-slate-400');
        }
        // Filter entries
        document.querySelectorAll('.log-entry').forEach(function(entry) {
            if (category === 'all') {
                entry.classList.remove('hidden');
            } else {
                var match = entry.getAttribute('data-category') === category;
                entry.classList.toggle('hidden', !match);
            }
        });
    }
    function refreshVectorLog() {
        var icon = event.currentTarget.querySelector('i');
        icon.classList.add('animate-spin');
        setTimeout(function() { icon.classList.remove('animate-spin'); }, 800);
    }
    </script>

